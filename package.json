{
  "name": "@beyonk/svelte-hubspot",
  "version": "0.5.0",
  "scripts": {
    "dev": "vite dev --port 2200",
    "build": "vite build",
    "package": "svelte-package",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@beyonk/async-script-loader": "^2.3.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "repository": "https://github.com/beyonk/svelte-hubspot.git",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24"
  },
  "peerDependencies": {
