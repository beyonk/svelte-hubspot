  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@beyonk/eslint-config": "^10.1.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^9.39.5",
    "pkg-pr-new": "^0.0.88",
    "svelte": "^5.57.1",
    "svelte2tsx": "^0.7.61",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
